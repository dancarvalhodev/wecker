{
    "name": "wecker/app",
    "description": "A project to manager docker things using a web interface",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Bootstrap\\": "bootstrap/"
        }
    },
    "authors": [
        {
            "name": "Daniel Carvalho"
        }
    ],
    "require": {
        "php": ">=8.5",
        "slim/slim": "4.*",
        "slim/psr7": "1.*",
        "php-di/php-di": "7.*",
        "doctrine/dbal": "4.*",
        "vlucas/phpdotenv": "v5.6.3",
        "twig/twig": "v3.27.0",
        "php-di/slim-bridge": "3.*",
        "nesbot/carbon": "3.11.*",
        "slim/twig-view": "3.4.*",
        "respect/validation": "3.*",
        "guzzlehttp/guzzle": "^8.3",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "12.*",
        "fakerphp/faker": "v1.24.1",
        "phpstan/phpstan": "^2.3",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M",
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix"
    }
}
