{% extends "/layout/base.html.twig" %}

{% block content %}
    <section class="container py-5">
        <p class="wk-label mb-3">Docker, without the terminal</p>
        <h1 class="fw-bold mb-3 wk-mono-strong">$ manage containers without the chaos</h1>
        <p class="text-secondary mb-4" style="max-width: 640px;">
            A simple interface, inspired by Portainer, to start, stop and inspect your containers.
        </p>
        <a href="/login" class="btn btn-primary btn-lg px-4">Get started</a>
    </section>

    <section class="container pb-5">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="wk-panel p-4 h-100">
                    <p class="wk-label mb-2">Fast control</p>
                    <p class="mb-0">Start, stop and inspect containers in one click.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="wk-panel p-4 h-100">
                    <p class="wk-label mb-2">Clear overview</p>
                    <p class="mb-0">See what is running without digging through the CLI.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="wk-panel p-4 h-100">
                    <p class="wk-label mb-2">You stay in charge</p>
                    <p class="mb-0">No black boxes: it talks straight to the Docker API.</p>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
