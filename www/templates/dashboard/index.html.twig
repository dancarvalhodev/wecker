{% extends "/layout/base.html.twig" %}

{% block title %}Containers · Wecker{% endblock %}

{% block content %}
    <section class="container py-4">
        <h1 class="fs-5 fw-semibold mb-4 wk-mono-strong"><span class="wk-accent">$</span> docker ps -a</h1>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="wk-stat wk-stat--running">
                    <div class="wk-label">Running</div>
                    <div class="wk-stat__value">{{ '%02d'|format(docker.running|default(0)) }}</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="wk-stat wk-stat--stopped">
                    <div class="wk-label">Stopped</div>
                    <div class="wk-stat__value">{{ '%02d'|format(docker.stopped|default(0)) }}</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="wk-stat">
                    <div class="wk-label">Total</div>
                    <div class="wk-stat__value">{{ '%02d'|format(docker.total|default(0)) }}</div>
                </div>
            </div>
        </div>

        <div class="wk-panel p-3">
            <div class="table-responsive">
                <table id="dashtable" class="table align-middle mb-0">
                    <thead>
                    <tr>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Image</th>
                        <th>Ports</th>
                        <th class="text-end">Actions</th>
                    </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </section>

    <div class="modal fade" id="logModal" tabindex="-1" aria-labelledby="logModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content wk-panel">
                <div class="modal-header">
                    <h2 class="modal-title wk-label" id="logModalTitle">Logs <span class="text-secondary">— last 10 lines</span></h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <pre id="logContent" class="wk-logs"></pre>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    {{ parent() }}
    <script src="assets/js/pages/dashboard.js"></script>
    <script>
        $(document).ready(function () {
            Dashboard.init();
        });
    </script>
{% endblock %}
