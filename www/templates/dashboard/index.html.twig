{% extends "/layout/base.html.twig" %}

{% block title %}Containers · Wecker{% endblock %}

{% block content %}
    <section class="container py-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <h1 class="fs-5 fw-semibold mb-0 wk-mono-strong"><span class="wk-accent">$</span> docker ps -a</h1>
            <button type="button" class="btn btn-primary px-3 py-2" data-bs-toggle="modal" data-bs-target="#createModal">+ Create</button>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="wk-stat wk-stat--running">
                    <div class="wk-label">Running</div>
                    <div class="wk-stat__value">{{ '%02d'|format(docker.running|default(0)) }}</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="wk-stat wk-stat--stopped">
                    <div class="wk-label">Stopped</div>
                    <div class="wk-stat__value">{{ '%02d'|format(docker.stopped|default(0)) }}</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="wk-stat">
                    <div class="wk-label">Total</div>
                    <div class="wk-stat__value">{{ '%02d'|format(docker.total|default(0)) }}</div>
                </div>
            </div>
        </div>

        <div class="wk-panel p-3">
            <div class="table-responsive">
                <table id="dashtable" class="table align-middle mb-0">
                    <thead>
                    <tr>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Image</th>
                        <th>Ports</th>
                        <th class="text-end">Actions</th>
                    </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </section>

    <div class="modal fade" id="logModal" tabindex="-1" aria-labelledby="logModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content wk-panel">
                <div class="modal-header">
                    <h2 class="modal-title wk-label" id="logModalTitle">Logs <span class="text-secondary">— last 10 lines</span></h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <pre id="logContent" class="wk-logs"></pre>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <form id="create-form" class="modal-content wk-panel">
                <div class="modal-header">
                    <h2 class="modal-title wk-label" id="createModalTitle">New container</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body row g-3">
                    <div class="col-md-6">
                        <label for="create-image" class="form-label wk-label">Image *</label>
                        <input type="text" class="form-control" id="create-image" name="image" placeholder="nginx:alpine" required>
                    </div>
                    <div class="col-md-6">
                        <label for="create-name" class="form-label wk-label">Name</label>
                        <input type="text" class="form-control" id="create-name" name="name" placeholder="web">
                    </div>
                    <div class="col-md-6">
                        <label for="create-ports" class="form-label wk-label">Ports</label>
                        <input type="text" class="form-control" id="create-ports" name="ports" placeholder="8081:80, 8443:443">
                    </div>
                    <div class="col-md-6">
                        <label for="create-restart" class="form-label wk-label">Restart policy</label>
                        <select class="form-select" id="create-restart" name="restart">
                            <option value="no">no</option>
                            <option value="always">always</option>
                            <option value="unless-stopped">unless-stopped</option>
                            <option value="on-failure">on-failure</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label for="create-env" class="form-label wk-label">Environment (one KEY=value per line)</label>
                        <textarea class="form-control" id="create-env" name="env" rows="3" placeholder="APP_ENV=production"></textarea>
                    </div>
                    <div class="col-12 form-check ms-2">
                        <input class="form-check-input" type="checkbox" id="create-start" name="start" value="1" checked>
                        <label class="form-check-label" for="create-start">Start after creating</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-muted" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="create-submit">Create</button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    {{ parent() }}
    <script src="assets/js/pages/dashboard.js"></script>
    <script src="assets/js/pages/create.js"></script>
    <script>
        $(document).ready(function () {
            Dashboard.init();
            Create.init();
        });
    </script>
{% endblock %}
