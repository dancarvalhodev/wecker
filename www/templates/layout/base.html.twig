<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    {% block head %}
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&display=swap">
        <link rel="stylesheet" href="assets/css/reset.css"/>
        <link rel="stylesheet" href="assets/css/boostrap/bootstrap.min.css"/>
        <link rel="stylesheet" href="assets/css/datatables/datatables.min.css"/>
        <link rel="stylesheet" href="assets/css/style.css"/>
        <title>{% block title %}Wecker{% endblock %}</title>
    {% endblock %}
</head>
<body>
<header class="wk-header">
    <div class="container d-flex flex-wrap align-items-center justify-content-between gap-3 py-3">
        <a class="wk-brand fs-5" href="/"><span>&gt;_</span> WECKER</a>
        <nav class="wk-nav d-flex flex-wrap align-items-center gap-4">
            {% if auth.logged %}
                <a href="/dashboard">Containers</a>
                <a href="/logout">Logout</a>
            {% else %}
                <a href="/login">Login</a>
            {% endif %}
        </nav>
    </div>
</header>
<main id="main-content">{% block content %}{% endblock %}</main>
<footer class="container py-4 wk-label">
    © {{ global.year }} Wecker
</footer>
{% block scripts %}
    <script src="assets/js/boostrap/bootstrap.bundle.min.js"></script>
    <script src="assets/js/jquery/jquery4-min.js"></script>
    <script src="assets/js/sweetalert2/sweetalert2.min.js"></script>
    <script src="assets/js/datatables/datatables.min.js"></script>
{% endblock %}
</body>
</html>
