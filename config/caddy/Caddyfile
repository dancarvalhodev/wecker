:80 {
	root * /var/www/html/public

	log

	request_body {
		max_size 100MB
	}

	@trailingSlash {
		path_regexp withSlash ^/(.+)/$
		not file
	}
	redir @trailingSlash /{re.withSlash.1} 301

	@hidden path */.ht*
	respond @hidden 403

	@static path *.ico *.css *.js *.jpg *.jpeg *.JPG *.png *.svg *.woff
	header @static Cache-Control "public, max-age=31536000"

	php_fastcgi php:9000 {
		env APP_ENV development
	}

	file_server
}
